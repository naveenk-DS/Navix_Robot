<mujoco model="navix_robot_small">
    <compiler angle="radian" autolimits="true"/>
    <option gravity="0 0 -9.81" timestep="0.002"/>
    <default>
        <joint damping="0.05" armature="0.001"/>
        <geom friction="1 0.5 0.5" density="800"/>
        <motor ctrllimited="true" ctrlrange="-1 1"/>
    </default>

    <worldbody>
        <geom name="ground" type="plane" size="2 2 0.1" pos="0 0 0"/>
        <body name="torso" pos="0 0 0.215">
            <freejoint/>
            <geom name="torso_geom" type="box" size="0.06 0.045 0.05"/>
            <site name="imu_site" pos="0 0 0" size="0.01"/>

            <body name="left_leg" pos="-0.03 0 -0.05">
                <joint name="left_hip" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
                <geom name="left_upper_leg" type="capsule" fromto="0 0 0 0 0 -0.07" size="0.015"/>
                <body name="left_lower_leg" pos="0 0 -0.07">
                    <joint name="left_knee" type="hinge" axis="0 1 0" range="-1.5 0.2"/>
                    <geom name="left_lower_leg_geom" type="capsule" fromto="0 0 0 0 0 -0.07" size="0.012"/>
                    <body name="left_foot" pos="0 0 -0.07">
                        <joint name="left_ankle" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
                        <geom name="left_foot_geom" type="box" size="0.03 0.02 0.01" pos="0.01 0 -0.01"/>
                    </body>
                </body>
            </body>

            <body name="right_leg" pos="0.03 0 -0.05">
                <joint name="right_hip" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
                <geom name="right_upper_leg" type="capsule" fromto="0 0 0 0 0 -0.07" size="0.015"/>
                <body name="right_lower_leg" pos="0 0 -0.07">
                    <joint name="right_knee" type="hinge" axis="0 1 0" range="-1.5 0.2"/>
                    <geom name="right_lower_leg_geom" type="capsule" fromto="0 0 0 0 0 -0.07" size="0.012"/>
                    <body name="right_foot" pos="0 0 -0.07">
                        <joint name="right_ankle" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
                        <geom name="right_foot_geom" type="box" size="0.03 0.02 0.01" pos="0.01 0 -0.01"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <sensor>
        <jointpos name="left_hip_position" joint="left_hip"/>
        <jointpos name="left_knee_position" joint="left_knee"/>
        <jointpos name="left_ankle_position" joint="left_ankle"/>
        <jointpos name="right_hip_position" joint="right_hip"/>
        <jointpos name="right_knee_position" joint="right_knee"/>
        <jointpos name="right_ankle_position" joint="right_ankle"/>
        <jointvel name="left_hip_velocity" joint="left_hip"/>
        <jointvel name="left_knee_velocity" joint="left_knee"/>
        <jointvel name="left_ankle_velocity" joint="left_ankle"/>
        <jointvel name="right_hip_velocity" joint="right_hip"/>
        <jointvel name="right_knee_velocity" joint="right_knee"/>
        <jointvel name="right_ankle_velocity" joint="right_ankle"/>
        <framequat name="torso_orientation" objtype="site" objname="imu_site"/>
        <gyro name="torso_gyro" site="imu_site"/>
        <accelerometer name="torso_acceleration" site="imu_site"/>
    </sensor>

    <actuator>
        <motor name="left_hip_motor" joint="left_hip" gear="2"/>
        <motor name="left_knee_motor" joint="left_knee" gear="2"/>
        <motor name="left_ankle_motor" joint="left_ankle" gear="2"/>
        <motor name="right_hip_motor" joint="right_hip" gear="2"/>
        <motor name="right_knee_motor" joint="right_knee" gear="2"/>
        <motor name="right_ankle_motor" joint="right_ankle" gear="2"/>
    </actuator>
</mujoco>
